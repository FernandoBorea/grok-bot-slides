    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "convex-test": "^0.0.59",
    "typescript": "^5.9.0",
    "vite": "^6.4.2",
    "vitest": "^5.0.1"
  }
